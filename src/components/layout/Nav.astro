---
import type { NavItem } from "../../data/nav";
import { url } from "../../lib/url";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<ul class="flex items-center">
  {
    items.map((item) => (
      <li class="group relative">
        {item.children ? (
          <>
            <button
              type="button"
              class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-white/90 transition-colors hover:text-white focus-visible:text-white"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <svg
                class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="invisible absolute left-0 top-full z-30 w-80 translate-y-1 rounded-xl border border-border bg-surface p-2 opacity-0 shadow-card transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
              <ul class="flex max-h-[70vh] flex-col overflow-y-auto">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      target={child.external ? "_blank" : undefined}
                      rel={child.external ? "noopener" : undefined}
                      class="block rounded-lg px-3 py-2 text-sm font-medium text-ink hover:bg-surface-alt"
                    >
                      {child.label}
                    </a>
                    {child.children && (
                      <ul class="ml-3 border-l border-border pl-3">
                        {child.children.map((grandchild) => (
                          <li>
                            <a
                              href={url(grandchild.href)}
                              target={grandchild.external ? "_blank" : undefined}
                              rel={grandchild.external ? "noopener" : undefined}
                              class="block rounded-lg px-3 py-1.5 text-xs text-ink-soft hover:bg-surface-alt hover:text-ink"
                            >
                              {grandchild.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <a
            href={url(item.href)}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener" : undefined}
            class="block rounded-md px-3 py-2 text-sm font-medium text-white/90 transition-colors hover:text-white focus-visible:text-white"
          >
            {item.label}
          </a>
        )}
      </li>
    ))
  }
</ul>
