---
import { url } from "../../lib/url";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  compact?: boolean;
}

const { eyebrow, title, subtitle, image, imageAlt, primaryCta, secondaryCta, compact = false } = Astro.props;
---

<section class={`relative overflow-hidden ${compact ? "min-h-[38vh]" : "min-h-[62vh] sm:min-h-[70vh]"} flex items-end`}>
  <img src={url(image)} alt={imageAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
  <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/70 to-navy/20"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-navy/60 via-transparent to-transparent"></div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pb-12 pt-24 sm:px-6 sm:pb-16 lg:px-8">
    {eyebrow && (
      <p class="mb-3 inline-flex items-center rounded-full bg-white/15 px-3.5 py-1 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur-sm">
        {eyebrow}
      </p>
    )}
    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">{subtitle}</p>}

    {(primaryCta || secondaryCta) && (
      <div class="mt-7 flex flex-wrap gap-3">
        {primaryCta && (
          <a
            href={url(primaryCta.href)}
            class="inline-flex items-center justify-center rounded-lg bg-crimson px-5 py-3 text-sm font-semibold text-white shadow-card transition-colors hover:bg-crimson-deep"
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={url(secondaryCta.href)}
            class="inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
