---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class={`max-w-2xl ${align === "center" ? "mx-auto text-center" : ""}`}>
  {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-crimson">{eyebrow}</p>}
  <h2 class="text-2xl font-bold text-navy sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-ink-soft">{description}</p>}
</div>
