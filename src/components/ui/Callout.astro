---
interface Props {
  variant?: "info" | "warning" | "danger";
  title?: string;
}

const { variant = "info", title } = Astro.props;

const styles = {
  info: "border-navy-ink/20 bg-navy-ink/5 text-navy",
  warning: "border-amber-300 bg-amber-50 text-amber-900",
  danger: "border-crimson/25 bg-crimson/5 text-crimson-deep",
}[variant];

const iconColor = {
  info: "text-navy-ink",
  warning: "text-amber-600",
  danger: "text-crimson",
}[variant];
---

<div class={`rounded-xl border p-5 ${styles}`}>
  <div class="flex gap-3">
    <svg class={`mt-0.5 h-5 w-5 shrink-0 ${iconColor}`} viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M10 9v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="10" cy="6.5" r="0.9" fill="currentColor" />
    </svg>
    <div class="prose-body text-sm [&>p:last-child]:mb-0">
      {title && <p class="mb-1.5 font-semibold">{title}</p>}
      <slot />
    </div>
  </div>
</div>
