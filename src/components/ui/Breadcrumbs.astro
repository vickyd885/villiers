---
import { url } from "../../lib/url";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-soft">
    <li><a href={url("/")} class="hover:text-navy">Home</a></li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="text-border">/</li>
          <li>
            {item.href && i !== items.length - 1 ? (
              <a href={url(item.href)} class="hover:text-navy">
                {item.label}
              </a>
            ) : (
              <span class="font-medium text-ink" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
