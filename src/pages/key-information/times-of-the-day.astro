---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Hero from "../../components/ui/Hero.astro";
import Callout from "../../components/ui/Callout.astro";

const standardDay = [
  ["Free breakfast club", "7:45 – 8:20"],
  ["Gate 6 closes", "8:27"],
  ["Tutor time", "8:30 – 8:50"],
  ["Period 1", "8:50 – 9:40"],
  ["Period 2", "9:40 – 10:30"],
  ["Break", "10:30 – 10:50"],
  ["Period 3", "10:50 – 11:40"],
  ["Period 4", "11:40 – 12:30"],
  ["Lunch (Years 7, 8, 11 & Sixth Form)", "12:30 – 13:20"],
  ["Lunch (Years 9 & 10, second sitting)", "12:30 – 13:20"],
  ["Period 5", "13:20 – 14:10"],
  ["Period 6", "14:10 – 15:10"],
  ["Period 7 (Sixth Form only)", "15:20 – 16:10"],
  ["Period 8 (Sixth Form only)", "16:10 – 17:00"],
];
---

<BaseLayout title="Times of the Day" description="The daily timetable at Villiers High School, Monday to Friday.">
  <Hero compact title="Times of the Day" image="/images/campus/reception-entrance.jpg" imageAlt="The school's modern reception building" />
  <Breadcrumbs items={[{ label: "Key Parental Information", href: "/key-information" }, { label: "Times of the Day" }]} />

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 class="text-xl font-bold text-navy">Monday, Tuesday, Wednesday & Friday</h2>
    <div class="mt-4 overflow-hidden rounded-2xl border border-border">
      <table class="w-full text-sm">
        <tbody>
          {
            standardDay.map(([label, value], i) => (
              <tr class={i % 2 === 0 ? "bg-surface" : "bg-surface-alt"}>
                <th scope="row" class="px-5 py-3 text-left font-medium text-ink-soft">{label}</th>
                <td class="px-5 py-3 text-right font-semibold text-ink">{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <Callout variant="info" title="Thursdays are different">
        <p>Years 9 & 10 finish at 13:50. Years 7, 8, 11 and Sixth Form finish at 14:20.</p>
        <p class="mt-2">Staff training begins at 14:30 — there are no after-school activities on-site on Thursdays.</p>
      </Callout>
    </div>
  </section>
</BaseLayout>
